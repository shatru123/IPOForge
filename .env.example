# IPOForge Environment Configuration

# ASP.NET Core API
ASPNETCORE_ENVIRONMENT=Development
PORT=5000
ConnectionStrings__DefaultConnection=Host=localhost;Port=5432;Database=IPOForgeDb;Username=postgres;Password=postgrespassword
# For zero-setup in-memory database, use:
# ConnectionStrings__DefaultConnection=InMemory:IPOForgeDb

# JWT Authentication
Jwt__SecretKey=IPOForge_Super_Secret_Production_Grade_JWT_Key_2025_Min32Bytes!
Jwt__Issuer=IPOForge.Api
Jwt__Audience=IPOForge.Client

# CORS Configuration
FrontendUrl=http://localhost:5173

# Frontend (Vite)
VITE_API_BASE_URL=
